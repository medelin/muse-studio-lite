# Copy to .env (chmod 600). Nothing here is required for `make test` or `make demo`.
MODEL_API_KEY=            # Meta Model API key (https://dev.meta.ai)
MODEL_API_BASE_URL=https://api.meta.ai/v1
BASETEN_API_KEY=          # Muse Spark Open via Baseten (meta-models/muse-spark-open)
STUDIO_OPEN_WEIGHTS=0     # 1: copy, comment triage and leads on Muse Spark Open (docs/open-weights.md)
STUDIO_GLIMMER=0          # 1: Muse Glimmer comment pre-filter; needs GLIMMER_API_KEY
GLIMMER_API_KEY=          # Together AI key, or your self-hosted server's
GLIMMER_BASE_URL=         # default https://api.together.xyz/v1 (any OpenAI-compatible server)
GLIMMER_MODEL=            # default meta-models/Muse-Glimmer-30B
META_ADAPTER=mock         # mock | graph
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PAGE_TOKEN=
META_TOKEN_TRANSPORT=form # form: access_token in the POST body (default) | bearer: header
META_APP_SECRET=          # optional: adds appsecret_proof (HMAC-SHA256 of the token)
# EU Digital Services Act: required for an ad set that reaches the EU (shown in the Ad Library)
META_DSA_BENEFICIARY=     # who the ad is for (the advertised business)
META_DSA_PAYOR=           # who pays for the ad
# WhatsApp Cloud API (docs/whatsapp.md): off unless STUDIO_WHATSAPP=1 (or mock)
STUDIO_WHATSAPP=0
META_WHATSAPP_TOKEN=      # system-user token: whatsapp_business_messaging + _management
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_PIN=        # the number's 2FA PIN set at POST /{phone_id}/register (operator only)
STUDIO_WHATSAPP_VERIFY_TOKEN= # 16-128 chars [A-Za-z0-9_.~-]: the webhook's GET handshake
SESSION_SECRET=           # >= 32 random characters; required when JUDGE_PASSWORD is set
# >= 20 chars, >= 3 character classes; refused at startup otherwise. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
JUDGE_PASSWORD=
STUDIO_READ_ONLY=0        # 1 = kill switch: no model calls, no external writes
STUDIO_DAILY_BUDGET_USD=8
STUDIO_REPLAY=0           # 1 = serve recorded model responses (video / judges)
TRUSTED_PROXY=            # IP of the reverse proxy whose X-Forwarded-For is trusted
COOKIE_SECURE=1
STORE_PROMPTS=0
STUDIO_PRODUCT_PHOTO=     # your product photo (PNG/JPEG); default: the synthetic demo mug
STUDIO_PRODUCT_CONCEPT=mug  # noun phrase SAM 3.1 cuts out of that photo
STUDIO_KEEP_AUDIO=0       # 1 = keep converted voice briefs under STUDIO_DATA_DIR/audio
STUDIO_MAX_DAILY_BUDGET_PLN=50  # campaign.activate refused above this daily budget
# Link of the ad creative (https); required with META_ADAPTER=graph. STUDIO_LANDING_URL
# is accepted as an alias.
META_LANDING_URL=
