# Muse Studio Lite: yesterday's ad-spend fee per account to the Stripe Billing Meter
# (studio billing report-usage). One event per account and day; a rerun sends nothing new.
# Does nothing unless STRIPE_SPEND_PRICE_ID is set and STUDIO_SPEND_FEE_PCT > 0.
[Unit]
Description=Muse Studio Lite ad-spend fee report
After=muse-studio-lite.service

[Service]
Type=oneshot
User=muse
Group=muse
WorkingDirectory=/opt/muse-studio-lite/current
EnvironmentFile=/etc/muse-studio-lite/env
Environment=STUDIO_SANDBOX=1 STUDIO_DATA_DIR=/var/lib/muse-studio-lite PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/muse-studio-lite/current/.venv/bin/python -m studio.cli billing report-usage --env-file /dev/null
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/muse-studio-lite
PrivateTmp=yes
