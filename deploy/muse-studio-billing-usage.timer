# Daily ad-spend fee report to Stripe (deploy/muse-studio-billing-usage.service). Runs after
# midnight UTC so yesterday is complete, and after a few hourly insights snapshots of it.
[Unit]
Description=Daily Muse Studio Lite ad-spend fee report to Stripe

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
