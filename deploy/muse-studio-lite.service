# Muse Studio Lite: judge sandbox (uvicorn on 127.0.0.1:8000 behind Caddy).
# Installed to /etc/systemd/system by deploy/remote-install.sh.
[Unit]
Description=Muse Studio Lite (judge sandbox)
Documentation=https://github.com/medelin/muse-studio-lite/blob/main/docs/SANDBOX.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=muse
Group=muse
WorkingDirectory=/opt/muse-studio-lite/current
EnvironmentFile=/etc/muse-studio-lite/env
Environment=STUDIO_SANDBOX=1 STUDIO_DATA_DIR=/var/lib/muse-studio-lite PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# --no-proxy-headers: the app itself trusts X-Forwarded-For only from TRUSTED_PROXY (Caddy).
ExecStart=/opt/muse-studio-lite/current/.venv/bin/python -m uvicorn studio.app:app \
    --host 127.0.0.1 --port 8000 --workers 1 --no-proxy-headers --no-server-header \
    --no-access-log --limit-concurrency 64 --timeout-graceful-shutdown 10
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Resources
MemoryMax=768M
MemoryHigh=640M
TasksMax=128
LimitNOFILE=4096

# Filesystem
UMask=0077
StateDirectory=muse-studio-lite
StateDirectoryMode=0700
ReadWritePaths=/var/lib/muse-studio-lite
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Privileges
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
